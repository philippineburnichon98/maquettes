     "id": "vinification",
     "eyebrow": "La vinification",
     "title": "La méthode <em>ancestrale</em>",
     "lead": "Une double fermentation, pour une effervescence naturelle.",
     "items": [
      {
       "when": "1",
       "who": "Vendange et pressurage",
       "text": "Vendange manuelle, pressurage direct, courte macération pour la couleur rosée ; débourbage de 24 à 48 h."
      },
      {
       "when": "2",
       "who": "Première fermentation",
       "text": "En cuve, entre 4 et 10 °C, jusqu'à 6 % vol. ; mise en bouteille et stockage debout en caves à 12 °C."
      },
      {
       "when": "3",
       "who": "Prise de mousse",
       "text": "En bouteille, 5 à 6 mois, jusqu'à l'équilibre entre sucre, acidité et arômes, à 8 % vol."
      },
      {
       "when": "4",
       "who": "Dégorgement",
       "text": "Les dépôts de levures sont retirés : vidage, filtrage, remise en bouteille ; bouchage, muselage, étiquetage, puis la cave."
      }
